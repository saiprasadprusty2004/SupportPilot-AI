APP_ENV=development
DEMO_MODE=true
APP_URL=http://localhost:8080
DATABASE_URL=postgresql+psycopg://supportpilot_app:local_app_password@postgres:5432/supportpilot
WORKER_DATABASE_URL=postgresql+psycopg://supportpilot_worker:local_worker_password@postgres:5432/supportpilot
MIGRATION_DATABASE_URL=postgresql+psycopg://supportpilot:local_admin_password@postgres:5432/supportpilot
POSTGRES_PASSWORD=local_admin_password
APP_DB_PASSWORD=local_app_password
WORKER_DB_PASSWORD=local_worker_password
REDIS_URL=redis://redis:6379/0
SECRET_KEY=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
COMPOSIO_API_KEY=
COMPOSIO_GMAIL_AUTH_CONFIG=
COMPOSIO_SLACK_AUTH_CONFIG=
COMPOSIO_GOOGLEDRIVE_AUTH_CONFIG=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STORAGE_BACKEND=local
STORAGE_PATH=/app/data/uploads
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_REVISION=c9745ed1d9f207416be6d2e6f8de32d1f16199bf
WORKSPACE_CONCURRENCY=2
GLOBAL_CONCURRENCY=20
GROQ_REQUESTS_PER_MINUTE=20
GROQ_TOKENS_PER_MINUTE=7000
DOMAIN=localhost
TLS_EMAIL=admin@example.com
GHCR_IMAGE_PREFIX=
